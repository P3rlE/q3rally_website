---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { getCars, getLatestBuild, urlFor } from '../lib/sanity.js';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const build = await getLatestBuild();
const cars = await getCars();
---
<BaseLayout title="Q3Rally — Cars">
  <div slot="topbar" class="top-bar">
    <div class="top-bar-left">
      <div class="live-dot"></div>
      <span><b>BUILD {build?.version ?? '—'}</b> &nbsp;·&nbsp; LIVE &nbsp;·&nbsp; <b>{cars.length} VEHICLES</b></span>
    </div>
    <div class="top-bar-right">
      <span class="hl">FREE</span><span>·</span><span>OPEN SOURCE</span><span>·</span><span>GPL v2</span>
    </div>
  </div>

  <Nav slot="nav" active={`${b}/cars`} build={build} />

  <div class="page-header">
    <div>
      <div class="section-label"><span>CARS</span> &nbsp;/&nbsp; V{build?.version ?? '—'} VEHICLE ROSTER</div>
      <h1 class="page-title">PICK YOUR<br /><span class="orange">RIDE.</span></h1>
    </div>
    <div class="page-header-right">
      <div class="count-big">{cars.length}<span>.</span></div>
      <div class="count-label">Vehicles</div>
    </div>
  </div>

  <section class="cars-section">
    <div class="cars-grid">
      {cars.map((car, i) => (
        <div class={`car-card ${i === 0 ? 'featured' : ''}`}>
          <div class="car-img">
            {car.image
              ? <img src={urlFor(car.image).ignoreImageParams().width(1200).fit('max').auto('format').url()} alt={car.name} loading={i < 4 ? 'eager' : 'lazy'} />
              : <span class="placeholder">[ IMAGE ]</span>
            }
            <div class="car-img-overlay"></div>
          </div>
          <div class="car-info">
            <div class="car-name">{car.name}</div>
            {car.description && <div class="car-desc">{car.description}</div>}
          </div>
          <span class="car-num">{String(i + 1).padStart(2, '0')}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector('.cars-grid');
  const cards = Array.from(grid?.querySelectorAll<HTMLElement>('.car-card') ?? []);

  if (grid && cards.length > 0) {
    const featured = cards[Math.floor(Math.random() * cards.length)];
    cards.forEach(card => card.classList.toggle('featured', card === featured));
    grid.prepend(featured);

    const image = featured.querySelector('img');
    if (image) {
      image.loading = 'eager';
      image.fetchPriority = 'high';
    }
    grid.querySelectorAll('.car-num').forEach((number, index) => {
      number.textContent = String(index + 1).padStart(2, '0');
    });
  }
</script>

<style>
  .top-bar { background: var(--black); border-bottom: 1px solid #222; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 36px; font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .top-bar-left { display: flex; align-items: center; gap: 10px; }
  .live-dot { width: 7px; height: 7px; background: var(--orange); border-radius: 50%; animation: pulse 2s infinite; }
  .top-bar-left span { color: var(--gray-light); }
  .top-bar-left span b { color: var(--white); }
  .top-bar-right { display: flex; align-items: center; gap: 16px; color: var(--gray); font-size: 10px; }
  .hl { color: var(--orange); }

  .page-header { background-color: var(--dark); background-image: var(--stripe); padding: 56px 80px 52px; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #222; }
  .section-label { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 14px; }
  .section-label span { color: var(--orange); }
  .page-title { font-family: 'Barlow Condensed', sans-serif; font-size: clamp(64px, 8vw, 110px); font-weight: 900; line-height: 0.88; text-transform: uppercase; }
  .page-title .orange { color: var(--orange); font-style: italic; }
  .page-header-right { text-align: right; }
  .count-big { font-family: 'Barlow Condensed', sans-serif; font-size: 56px; font-weight: 900; line-height: 1; }
  .count-big span { color: var(--orange); }
  .count-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 4px; }

  .cars-section { padding: 48px 80px 80px; background: var(--black); }
  .cars-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .car-card { background: var(--dark2); cursor: pointer; transition: background 0.15s; position: relative; overflow: hidden; }
  .car-card:hover { background: #1e1e1e; }
  .car-card:hover .car-img-overlay { opacity: 1; }
  .car-card.featured { grid-column: span 2; }
  .car-card.featured .car-img { aspect-ratio: 2/1; }
  .car-card.featured .car-name { font-size: 30px; }
  .car-img { aspect-ratio: 4/3; background-color: #161616; background-image: var(--stripe); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .car-img img { width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .placeholder { font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #2e2e2e; }
  .car-img-overlay { position: absolute; inset: 0; background: rgba(255,85,0,0.07); opacity: 0; transition: opacity 0.2s; border: 1px solid rgba(255,85,0,0.25); }
  .car-num { position: absolute; top: 12px; right: 12px; font-family: 'Share Tech Mono', monospace; font-size: 9px; letter-spacing: 0.1em; color: #2e2e2e; }
  .car-info { padding: 18px 20px 22px; border-top: 1px solid #252525; }
  .car-name { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1; margin-bottom: 8px; }
  .car-desc { font-size: 12px; color: var(--gray); line-height: 1.55; }

  @media (max-width: 768px) {
    .top-bar { padding: 0 16px; height: 32px; }
    .top-bar-right { display: none; }
    .page-header { padding: 36px 20px 32px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .cars-section { padding: 28px 16px 48px; }
    .cars-grid { grid-template-columns: repeat(2, 1fr); }
    .car-card.featured { grid-column: span 2; }
    .count-big { font-size: 40px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import catalog from '../data/garageCatalog.json';
import { getLatestBuild } from '../lib/sanity.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const build = await getLatestBuild();
const paints = Object.entries(catalog.vehicles.alpine.paints);
const wheels = Object.entries(catalog.wheels);

---

<BaseLayout title="Q3Rally | Garage">
  <div slot="topbar" class="garage-topbar">
    <span><i aria-hidden="true"></i> BUILD {build?.version ?? '—'} · WEB GARAGE</span>
    <span class="preview-status">V0.9 PREVIEW</span>
  </div>
  <Nav slot="nav" active={base + '/garage'} build={build} />
  <div class="garage-surface">
  <section class="garage" data-garage data-assets={base + '/garage/'} data-api={base + '/api/profile.php'}>
    <header class="garage-header">
      <div>
        <p class="eyebrow">01 / WEB GARAGE</p>
        <h1>Your <em>garage.</em></h1>
        <p class="intro">Choose a vehicle, then save its paint and wheels to your web profile.</p>
      </div>
      <div class="header-actions">
        <a href="#web-profile" data-profile-link>Web profile <span aria-hidden="true">↓</span></a>
        <button type="button" class="secondary" data-logout hidden>Sign out</button>
      </div>
    </header>
    <div class="garage-grid">
      <section class="preview" aria-label="Selected setup">
        <div class="preview-heading">
          <p class="eyebrow">SHOWROOM</p>
          <h2 data-vehicle-name>Alpine</h2>
        </div>
        <figure class="car">
          <img data-preview="paint" src={base + '/garage/alpine-blue.png'} alt="Alpine in blue" />
          <figcaption data-label="paint">Blue</figcaption>
        </figure>
        <div class="showroom-3d" data-showroom hidden></div>
        <div class="showroom-actions">
          <button type="button" class="secondary" data-3d-toggle>3D view</button>
          <button type="button" class="secondary" data-3d-reset hidden>Reset view</button>
          <p role="status" data-3d-status></p>
        </div>
        <figure class="wheel">
          <img data-preview="wheels" src={base + '/garage/wheels-svt_cobra.png'} alt="SVT Cobra" />
          <figcaption data-label="wheels">SVT Cobra</figcaption>
        </figure>
      </section>
      <form data-setup>
        <p class="eyebrow">02 / CONFIGURATION</p>
        <h2>Make it yours</h2>
        <label class="vehicle-picker">
          Vehicle
          <select name="vehicle">
            {Object.entries(catalog.vehicles).map(([id, car]) => <option value={id}>{car.name}</option>)}
          </select>
        </label>
        <fieldset>
          <legend>Paint</legend>
          <div class="choices" data-paints>
            {paints.map(([id, paint], index) => (
              <label>
                <input type="radio" name="paint" value={id} checked={index === 0}
                  data-image={base + '/garage/' + paint.image} data-name={paint.name} />
                <span class="tile"><img src={base + '/garage/' + paint.image} alt="" /><span>{paint.name}</span></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>Wheels</legend>
          <label class="wheel-filter">Find wheels
            <input type="search" data-wheel-filter placeholder="Search by name" autocomplete="off" />
          </label>
          <p data-wheel-count aria-live="polite">{wheels.length} wheel sets</p>
          <div class="choices wheel-choices">
            {wheels.map(([id, name], index) => (
              <label>
                <input type="radio" name="wheels" value={id} checked={index === 0}
                  data-image={base + '/garage/wheels-' + id + '.png'} data-name={name} />
                <span class="tile"><img src={base + '/garage/wheels-' + id + '.png'} alt="" loading="lazy" /><span>{name}</span></span>
              </label>
            ))}
          </div>
        </fieldset>
        <button type="submit" disabled>Save to web profile</button>
        <p role="status">Preview setup</p>
      </form>
    </div>
    <details id="web-profile" data-profile>
      <summary>Web profile</summary>
    <form data-account>
      <fieldset>
        <legend>Web profile</legend>
        <label data-email>Email <input name="email" type="email" autocomplete="username" required /></label>
        <label data-password>Password <input name="password" type="password" autocomplete="current-password" required /></label>
      </fieldset>
      <button name="action" value="login">Sign in</button>
      <button name="action" value="register">Create account</button>
      <button name="action" value="verify" hidden>Confirm email</button>
      <button name="action" value="request_reset" hidden>Send reset link</button>
      <button name="action" value="reset_password" hidden>Save new password</button>
      <button type="button" data-forgot>Forgot password?</button>
    </form>
    <p role="status" data-account-status>Sign in to save your vehicle setups to your web profile.</p>
    </details>
    <details data-devices hidden>
      <summary>Game connection</summary>
      <form data-link-device>
        <label>Q3Rally device code
          <input name="code" required minlength="10" maxlength="10" pattern="[0-9A-Fa-f]{10}" autocomplete="off" spellcheck="false" />
        </label>
        <button type="submit">Link game</button>
        <button type="button" data-revoke>Revoke all game links</button>
        <p role="status">Enter the code shown by your copy of Q3Rally.</p>
      </form>
    </details>
  </section>
  </div>
</BaseLayout>

<script>
  import catalog from '../data/garageCatalog.json';

  function setupGarage(garage: HTMLElement) {
    const account = garage.querySelector<HTMLFormElement>('[data-account]')!;
    const form = garage.querySelector<HTMLFormElement>('[data-setup]')!;
    const profile = garage.querySelector<HTMLDetailsElement>('[data-profile]')!;
    const profileLink = garage.querySelector<HTMLAnchorElement>('[data-profile-link]')!;
    const logout = garage.querySelector<HTMLButtonElement>('[data-logout]')!;
    const accountStatus = garage.querySelector<HTMLElement>('[data-account-status]')!;
    const status = form.querySelector<HTMLElement>('[role="status"]')!;
    const devices = garage.querySelector<HTMLElement>('[data-devices]')!;
    const link = devices.querySelector<HTMLFormElement>('[data-link-device]')!;
    const revoke = devices.querySelector<HTMLButtonElement>('[data-revoke]')!;
    const deviceStatus = link.querySelector<HTMLElement>('[role="status"]')!;
    const save = form.querySelector<HTMLButtonElement>('button')!;
    const email = account.querySelector<HTMLInputElement>('[name="email"]')!;
    const password = account.querySelector<HTMLInputElement>('[name="password"]')!;
    const forgot = account.querySelector<HTMLButtonElement>('[data-forgot]')!;
    const actions = [...account.querySelectorAll<HTMLButtonElement>('button[name="action"]')];
    const vehicle = form.querySelector<HTMLSelectElement>('select[name="vehicle"]')!;
    const wheelFilter = form.querySelector<HTMLInputElement>('[data-wheel-filter]')!;
    const wheelCount = form.querySelector<HTMLElement>('[data-wheel-count]')!;
    const wheelOptions = [...form.querySelectorAll<HTMLInputElement>('[name="wheels"]')];

    function filterWheels() {
      const terms = wheelFilter.value.trim().toLowerCase().split(/\s+/);
      let visible = 0;
      for (const wheel of wheelOptions) {
        const matches = terms.every(term => (wheel.dataset.name + ' ' + wheel.value).toLowerCase().includes(term));
        wheel.closest('label')!.hidden = !matches && !wheel.checked;
        if (matches) visible++;
      }
      wheelCount.textContent = visible ? visible + (visible === 1 ? ' matching wheel set' : ' matching wheel sets') : 'No matching wheel sets';
    }
    wheelFilter.addEventListener('input', filterWheels);

    const paints = form.querySelector<HTMLElement>('[data-paints]')!;
    const vehicleName = garage.querySelector<HTMLElement>('[data-vehicle-name]')!;
    const showroom = garage.querySelector<HTMLElement>('[data-showroom]')!;
    const showroomToggle = garage.querySelector<HTMLButtonElement>('[data-3d-toggle]')!;
    const showroomReset = garage.querySelector<HTMLButtonElement>('[data-3d-reset]')!;
    const showroomStatus = garage.querySelector<HTMLElement>('[data-3d-status]')!;
    const carImage = garage.querySelector<HTMLImageElement>('[data-preview="paint"]')!;
    let viewer: Awaited<ReturnType<typeof import('../scripts/vehicleShowroom').openVehicleShowroom>> | undefined;
    let viewerVehicle = '';
    let use3d = false;
    let renderVersion = 0;
    let loadVersion = 0;

    function showPhoto() {
      renderVersion++;
      viewer?.hide();
      showroom.hidden = true;
      carImage.classList.remove('showroom-inactive');
      showroomReset.hidden = true;
      showroomToggle.textContent = '3D view';
      showroomStatus.textContent = '';
    }

    function closeShowroom() {
      use3d = false;
      loadVersion++;
      showroomToggle.disabled = false;
      showPhoto();
    }

    async function refreshShowroom() {
      if (!viewer || !use3d || viewerVehicle !== vehicle.value) return;
      const version = ++renderVersion;
      const fields = new FormData(form);
      try {
        await viewer.update(String(fields.get('paint')), String(fields.get('wheels')));
        if (version !== renderVersion) return;
        showroom.hidden = false;
        carImage.classList.add('showroom-inactive');
        showroomReset.hidden = false;
        showroomToggle.textContent = 'Photo view';
        showroomStatus.textContent = 'Drag to orbit · scroll or pinch to zoom';
        viewer.show();
      } catch {
        if (version !== renderVersion) return;
        closeShowroom();
        showroomStatus.textContent = '3D preview unavailable. Showing the vehicle image.';
      }
    }

    async function loadShowroom() {
      const selected = vehicle.value;
      const version = ++loadVersion;
      showPhoto();
      showroomToggle.disabled = true;
      showroomStatus.textContent = 'Loading 3D view…';
      try {
        if (!viewer || viewerVehicle !== selected) {
          viewer?.dispose();
          viewer = undefined;
          const { openVehicleShowroom } = await import('../scripts/vehicleShowroom');
          if (version !== loadVersion) return;
          const next = await openVehicleShowroom(showroom, garage.dataset.assets + 'showroom/', selected, vehicleName.textContent || selected);
          if (version !== loadVersion) {
            next.dispose();
            return;
          }
          viewer = next;
          viewerVehicle = selected;
        }
        await refreshShowroom();
      } catch {
        if (version !== loadVersion) return;
        closeShowroom();
        showroomStatus.textContent = '3D preview unavailable. Showing the vehicle image.';
      } finally {
        if (version === loadVersion) showroomToggle.disabled = false;
      }
    }

    showroomToggle.addEventListener('click', () => {
      if (use3d) closeShowroom();
      else {
        use3d = true;
        void loadShowroom();
      }
    });
    showroomReset.addEventListener('click', () => viewer?.reset());
    showroom.addEventListener('webglcontextlost', event => {
      event.preventDefault();
      closeShowroom();
      viewer?.dispose();
      viewer = undefined;
      showroomStatus.textContent = '3D preview unavailable. Showing the vehicle image.';
    }, true);
    type Setup = { vehicle: string; paint: string; wheels: string };
    const saved = new Map<string, Setup>();
    const vehicles: Record<string, { name: string; paints: Record<string, { name: string; image: string }> }> = catalog.vehicles;

    function choices() { return [...form.querySelectorAll<HTMLInputElement>('input[type="radio"]')]; }

    function showVehicle() {
      const car = vehicles[vehicle.value];
      if (!car) return;
      const template = paints.querySelector('label')!.cloneNode(true) as HTMLLabelElement;
      const setup = saved.get(vehicle.value);
      paints.replaceChildren(...Object.entries(car.paints).map(([id, paint], index) => {
        const label = template.cloneNode(true) as HTMLLabelElement;
        const input = label.querySelector('input')!;
        const source = garage.dataset.assets + paint.image;
        input.value = id;
        input.checked = setup?.paint && car.paints[setup.paint] ? setup.paint === id : index === 0;
        input.dataset.image = source;
        input.dataset.name = paint.name;
        label.querySelector('img')!.src = source;
        label.querySelector('.tile span')!.textContent = paint.name;
        return label;
      }));
      for (const [index, wheel] of wheelOptions.entries()) {
        wheel.checked = setup?.wheels ? setup.wheels === wheel.value : index === 0;
      }
      filterWheels();
      vehicleName.textContent = car.name;

      status.textContent = setup ? 'Saved setup loaded.' : 'Preview setup';
      refresh();
    }
    const linkParams = new URLSearchParams(location.hash.slice(1));
    let mode = linkParams.has('reset') ? 'reset_password' : linkParams.has('verify') ? 'verify' : 'login';
    let token = linkParams.get(mode === 'reset_password' ? 'reset' : 'verify');
    if (token) history.replaceState(null, '', location.pathname + location.search);

    function refresh() {
      for (const input of choices().filter(choice => choice.checked)) {
        const image = garage.querySelector<HTMLImageElement>('[data-preview="' + input.name + '"]')!;
        const caption = garage.querySelector('[data-label="' + input.name + '"]')!;
        image.src = input.dataset.image!;
        image.alt = input.name === 'paint' ? vehicleName.textContent + ' in ' + input.dataset.name : input.dataset.name!;
        caption.textContent = input.dataset.name!;
      }
      void refreshShowroom();
    }

    async function request(body?: Record<string, FormDataEntryValue | null>) {
      const response = await fetch(garage.dataset.api!, body ? {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      } : undefined);
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Profile service unavailable');
      return result;
    }

    async function showAccount(signedIn: boolean) {
      profile.hidden = signedIn;
      profileLink.hidden = signedIn;
      account.hidden = signedIn;
      logout.hidden = !signedIn;
      save.disabled = !signedIn;
      devices.hidden = !signedIn;
      if (!signedIn) devices.removeAttribute('open');
      if (!signedIn) {
        link.reset();
        deviceStatus.textContent = 'Enter the code shown by your copy of Q3Rally.';
      }
      email.disabled = !!token;
      email.required = !token;
      account.querySelector<HTMLElement>('[data-email]')!.hidden = !!token;
      password.disabled = mode === 'request_reset';
      password.required = !password.disabled;
      password.autocomplete = mode === 'reset_password' ? 'new-password' : 'current-password';
      account.querySelector<HTMLElement>('[data-password]')!.hidden = password.disabled;
      forgot.hidden = !!token;
      forgot.textContent = mode === 'request_reset' ? 'Back to sign in' : 'Forgot password?';
      for (const button of actions) {
        button.hidden = mode === 'login' ? !['login', 'register'].includes(button.value) : button.value !== mode;
      }
      if (signedIn) {
        const { setups } = await request({ action: 'garage_list' });
        saved.clear();
        for (const setup of setups as Setup[]) saved.set(setup.vehicle, setup);
        showVehicle();
      }
    }

    profileLink.addEventListener('click', () => { profile.open = true; });

    forgot.addEventListener('click', () => {
      mode = mode === 'request_reset' ? 'login' : 'request_reset';
      password.value = '';
      accountStatus.textContent = mode === 'request_reset' ? 'Enter the email address for your web profile.' : 'Sign in to your web profile.';
      void showAccount(false);
    });

    account.addEventListener('submit', async event => {
      event.preventDefault();
      const action = (event.submitter as HTMLButtonElement | null)?.value ?? mode;
      const fields = Object.fromEntries(new FormData(account));
      for (const button of actions) button.disabled = true;
      try {
        const result = await request({ ...fields, action, token });
        account.reset();
        if (result.verified || result.reset) {
          token = null;
          mode = 'login';
        }
        await showAccount(!!result.signedIn);
        accountStatus.textContent = result.message || (result.reset ? 'Password updated. Sign in and link your game again.' : result.verified ? 'Email confirmed. You can now sign in.' : 'Signed in.');
      } catch (error) {
        accountStatus.textContent = String(error instanceof Error ? error.message : error);
      } finally {
        for (const button of actions) button.disabled = false;
      }
    });

    logout.addEventListener('click', async () => {
      try {
        await request({ action: 'logout' });
        saved.clear();
        closeShowroom();
        form.reset();
        showVehicle();
        await showAccount(false);
        accountStatus.textContent = 'Signed out.';
      } catch (error) {
        accountStatus.textContent = String(error instanceof Error ? error.message : error);
      }
    });

    async function changeDevice(action: string) {
      const buttons = [...link.querySelectorAll('button')];
      for (const button of buttons) button.disabled = true;
      try {
        const code = new FormData(link).get('code');
        await request({ action, code });
        link.reset();
        deviceStatus.textContent = action === 'device_approve' ? 'Game linked.' : 'Game links revoked.';
      } catch (error) {
        deviceStatus.textContent = String(error instanceof Error ? error.message : error);
      } finally {
        for (const button of buttons) button.disabled = false;
      }
    }

    link.addEventListener('submit', event => {
      event.preventDefault();
      void changeDevice('device_approve');
    });
    revoke.addEventListener('click', () => {
      if (confirm('Revoke access for all linked copies of Q3Rally?')) {
        void changeDevice('device_revoke');
      }
    });

    form.addEventListener('change', event => {
      if (event.target === vehicle) {
        showVehicle();
        if (use3d) void loadShowroom();
      }
      else {
        filterWheels();
        refresh();
        status.textContent = 'Preview setup';
      }
    });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      save.disabled = true;
      try {
        const fields = Object.fromEntries(new FormData(form));
        const { setup } = await request({ ...fields, action: 'garage' });
        const id = String(fields.vehicle);
        saved.set(id, { vehicle: id, ...setup });
        if (vehicle.value === id) status.textContent = 'Setup saved to your web profile.';
      } catch (error) {
        status.textContent = String(error instanceof Error ? error.message : error);
      } finally {
        save.disabled = logout.hidden;
      }
    });

    if (token) {
      profile.open = true;
      profile.scrollIntoView({ block: 'center' });
      accountStatus.textContent = mode === 'reset_password'
        ? 'Choose a new password for your web profile.'
        : 'Enter your registration password to confirm this email address.';
      void showAccount(false);
    } else {
      request().then(result => showAccount(!!result.signedIn)).catch(() => {
        account.hidden = true;
        accountStatus.textContent = 'Web profiles are available in the v0.9 test environment.';
      });
    }
  }

  const garage = document.querySelector<HTMLElement>('[data-garage]');
  if (garage) setupGarage(garage);
</script>

<style>
  .garage {
    --accent: var(--orange);
    --panel: #171717;
    --line: #343434;
    --muted: #b7b7b7;
    max-width: 120rem;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4.5rem) clamp(1rem, 4.2vw, 5rem);
  }
  .garage-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    gap: .75rem;
    padding: .35rem clamp(1rem, 3vw, 28px);
    border-bottom: 1px solid #222;
    background: var(--black);
    font: 700 11px/1.4 'Barlow Condensed', sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .garage-topbar i { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--orange); }
  .preview-status { color: var(--orange); text-align: right; }
  .garage-surface { background: var(--black) var(--stripe); }
  .header-actions { flex-shrink: 0; }
  .header-actions a { display: inline-block; border: 1px solid #444; padding: .65rem .9rem; color: var(--white); }
  .garage-header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .eyebrow { margin: 0; color: var(--accent); font: 400 .75rem/1.4 'Share Tech Mono', monospace; letter-spacing: .16em; }
  h1, h2 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; line-height: .95; margin: .45rem 0; text-transform: uppercase; }
  h1 { font-size: clamp(2.4rem, 7vw, 5.5rem); text-transform: uppercase; }
  h1 em { color: var(--accent); }
  h2 { font-size: clamp(1.5rem, 4vw, 2.5rem); }
  .intro, [role="status"] { color: var(--muted); }
  .garage-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .preview, [data-setup], details { border: 1px solid var(--line); background: var(--panel); }
  .preview, [data-setup] { position: relative; }
  .preview::after, [data-setup]::after {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    background:
      linear-gradient(var(--accent), var(--accent)) top left / 10px 2px,
      linear-gradient(var(--accent), var(--accent)) top left / 2px 10px,
      linear-gradient(var(--accent), var(--accent)) top right / 10px 2px,
      linear-gradient(var(--accent), var(--accent)) top right / 2px 10px,
      linear-gradient(var(--accent), var(--accent)) bottom left / 10px 2px,
      linear-gradient(var(--accent), var(--accent)) bottom left / 2px 10px,
      linear-gradient(var(--accent), var(--accent)) bottom right / 10px 2px,
      linear-gradient(var(--accent), var(--accent)) bottom right / 2px 10px;
    background-repeat: no-repeat;
  }
  .preview {
    position: relative;
    display: grid;
    align-content: center;
    overflow: hidden;
    isolation: isolate;
    min-height: 23rem;
    background: radial-gradient(ellipse at 50% 45%, #38312d, #161616 65%);
    padding: 1.25rem;
  }
  .preview::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(130deg, transparent 0 17px, #ffffff08 17px 18px);
    mask-image: linear-gradient(to bottom, #000, transparent 75%);
  }
  .preview-heading { position: absolute; top: 1.25rem; left: 1.25rem; }
  figure { margin: 0; }
  figure img { display: block; object-fit: contain; width: 100%; }
  .car { margin: 2rem auto 1.5rem; width: min(100%, 26rem); }
  .car img { height: clamp(13rem, 30vw, 24rem); filter: drop-shadow(0 1.5rem 1.4rem #0009); }
  .car img.showroom-inactive { visibility: hidden; }
  .showroom-3d { position: absolute; inset: 3.5rem 0 2.75rem; }
  .showroom-3d :global(canvas) { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  .showroom-3d :global(canvas:active) { cursor: grabbing; }
  .showroom-actions { position: absolute; top: 1rem; right: 1rem; max-width: 55%; text-align: right; pointer-events: none; }
  .showroom-actions button { pointer-events: auto; }
  .showroom-actions [role="status"] { font-size: .72rem; }
  .car figcaption { position: absolute; bottom: 1.25rem; left: 1.25rem; }
  .wheel { position: absolute; right: 1.25rem; bottom: 1rem; text-align: center; }
  .wheel img { height: 3.5rem; }
  figcaption { color: var(--muted); font-size: .8rem; }
  [data-setup], [data-account], [data-link-device] { padding: 1.25rem; }
  [data-setup] h2 { margin-bottom: 1.5rem; }
  fieldset { border: 0; min-width: 0; margin: 0 0 1.15rem; padding: 0; }
  legend { font-weight: 700; margin-bottom: .55rem; }
  .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(4.25rem, 1fr)); gap: .45rem; }
  .choices label { position: relative; cursor: pointer; }
  .choices input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .tile {
    display: grid;
    place-items: center;
    align-content: start;
    height: 100%;
    gap: .25rem;
    padding: .45rem .2rem;
    border: 1px solid var(--line);
    background: #202020;
    text-align: center;
    font-size: .75rem;
  }

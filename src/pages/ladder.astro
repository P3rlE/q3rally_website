  .md-map { font-family: 'Barlow Condensed', sans-serif; font-size: 36px; font-weight: 900; text-transform: uppercase; line-height: 1; }
  .md-meta { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); margin-top: 8px; display: flex; gap: 16px; flex-wrap: wrap; }
  .md-table { width: 100%; border-collapse: collapse; }
  .md-table th { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.12em; text-transform: uppercase; text-align: left; padding: 8px 12px; border-bottom: 1px solid #1a1a1a; }
  .md-table td { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--gray-light); padding: 11px 12px; border-bottom: 1px solid #0f0f0f; }
  .md-table tbody tr:first-child td { color: var(--orange); }
  .md-player-link { cursor: pointer; }
  .md-player-link:hover { color: var(--orange); }

  @media (max-width: 768px) {
    /* TOP BAR */
    .top-bar { padding: 0 16px; height: 32px; }
    .top-bar-right { display: none; }

    /* PAGE HEADER */

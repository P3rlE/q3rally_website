---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { getLatestBuild } from '../lib/sanity.js';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const build = await getLatestBuild();
const API_BASE = 'https://ladder.q3rally.com/index.php';
const IMG_BASE  = 'https://ladder.q3rally.com/images';
---
<BaseLayout title="Q3Rally — Ladder" description="Q3Rally competitive ladder — top placements, match history and player profiles.">
  <div slot="topbar" class="top-bar">
    <div class="top-bar-left">
      <div class="live-dot"></div>
      <span><b>LADDER</b> &nbsp;·&nbsp; LIVE &nbsp;·&nbsp; <b id="tb-matches">—</b> MATCHES &nbsp;·&nbsp; <b id="tb-players">—</b> PLAYERS</span>
    </div>
    <div class="top-bar-right">
      <span class="hl">COMPETITIVE</span><span>·</span><span>RANKINGS</span><span>·</span><span>STATS</span>
    </div>
  </div>

  <Nav slot="nav" active={`${b}/ladder`} build={build} />

  <!-- PAGE HEADER -->
  <div class="page-header">
    <div>
      <div class="section-label"><span>LADDER</span> &nbsp;/&nbsp; COMPETITIVE RANKINGS</div>
      <h1 class="page-title">RACE<br /><span class="orange">THE TOP.</span></h1>
    </div>
    <div class="page-header-stats">
      <div class="hstat"><div class="hstat-val" id="hs-matches">—</div><div class="hstat-label">Matches</div></div>
      <div class="hstat"><div class="hstat-val" id="hs-players">—</div><div class="hstat-label">Players</div></div>
      <div class="hstat"><div class="hstat-val" id="hs-modes">—</div><div class="hstat-label">Game Modes</div></div>
      <div class="hstat"><div class="hstat-val" id="hs-updated">—</div><div class="hstat-label">Last Update</div></div>
    </div>
  </div>

  <!-- MAIN TABS -->
  <div class="main-tabs">
    <button class="main-tab active" data-tab="leaderboard">LEADERBOARD</button>
    <button class="main-tab" data-tab="activity">RECENT ACTIVITY</button>
    <button class="main-tab" data-tab="rankings">PLAYER RANKINGS</button>
    <button class="main-tab" data-tab="ghosts">GHOSTS</button>
    <a class="admin-link" href="https://ladder.q3rally.com/admin.php">ADMIN ↗</a>
  </div>

  <!-- ── LEADERBOARD TAB ── -->
  <div id="tab-leaderboard" class="tab-panel active">
    <div class="lb-toolbar">
      <div class="mode-tabs-wrap">
        <div class="mode-tabs" id="mode-tabs"></div>
      </div>
      <div class="ladder-filters">
        <div class="source-toggle" role="group" aria-label="Match source">
          <button class="src-btn active" data-src="all">ALL</button>
          <button class="src-btn" data-src="online">ONLINE</button>
          <button class="src-btn" data-src="offline">OFFLINE</button>
        </div>
        <div class="source-toggle weather-toggle" role="group" aria-label="Track weather">
          <button class="weather-btn src-btn active" data-weather="all" aria-pressed="true">ANY WEATHER</button>
          <button class="weather-btn src-btn" data-weather="dry" aria-pressed="false">DRY</button>
          <button class="weather-btn src-btn" data-weather="wet" aria-pressed="false">WET</button>
          <button class="weather-btn src-btn" data-weather="snow" aria-pressed="false">SNOW</button>
          <button class="weather-btn src-btn" data-weather="mixed" aria-pressed="false">MIXED</button>
        </div>
      </div>
    </div>
    <div class="lb-body">
      <div class="map-panel">
        <div class="map-panel-label">MAP</div>
        <select id="map-select" class="map-select"></select>
        <div id="map-levelshot" class="map-levelshot"></div>
        <div id="map-name" class="map-name"></div>
      </div>
      <div class="lb-table-wrap">
        <div id="lb-status" class="lb-status">Loading…</div>
        <table id="lb-table" class="lb-table" hidden>
          <thead>
            <tr>
              <th class="th-rank">RANK</th>
              <th>PLAYER</th>
              <th id="lb-col3">TIME</th>
              <th>VEHICLE</th>
              <th>SET ON</th>
            </tr>
          </thead>
          <tbody id="lb-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ── RECENT ACTIVITY TAB ── -->
  <div id="tab-activity" class="tab-panel">
    <div class="activity-wrap">
      <div id="activity-feed" class="activity-feed">
        <div class="lb-status">Loading…</div>
      </div>
    </div>
  </div>

  <!-- ── PLAYER RANKINGS TAB ── -->
  <div id="tab-rankings" class="tab-panel">
    <div class="rankings-wrap">
      <div class="rankings-toolbar">
        <input id="rankings-search" class="toolbar-input" type="text" placeholder="Search player…" />
        <div class="rankings-sort-btns">
          <button class="sort-btn active" data-sort="wins">WINS</button>
          <button class="sort-btn" data-sort="matches">MATCHES</button>
          <button class="sort-btn" data-sort="kd">K/D</button>
          <button class="sort-btn" data-sort="kills">KILLS</button>
        </div>
      </div>
      <table class="rankings-table" id="rankings-table">
        <thead>
          <tr>
            <th class="th-rank">#</th>
            <th>PLAYER</th>
            <th>WINS</th>
            <th>MATCHES</th>
            <th>KILLS</th>
            <th>DEATHS</th>
            <th>K/D</th>
            <th>BEST LAP</th>
          </tr>
        </thead>
        <tbody id="rankings-body"></tbody>
      </table>
    </div>
  </div>

  <!-- ── GHOSTS TAB ── lap ghosts from the ladder (GET /ghosts/catalog, /ghosts) -->
  <div id="tab-ghosts" class="tab-panel">
    <div class="lb-toolbar">
      <div class="mode-tabs-wrap">
        <div class="mode-tabs" id="gh-vehicle-tabs"></div>
      </div>
    </div>
    <div class="lb-body">
      <div class="map-panel">
        <div class="map-panel-label">MAP</div>
        <select id="gh-map" class="map-select"></select>
        <div class="map-panel-label">TRACK</div>
        <select id="gh-variant" class="map-select"></select>
        <div id="gh-build-wrap" class="gh-build-wrap" hidden>
          <div class="map-panel-label">MAP VERSION</div>
          <select id="gh-build" class="map-select"></select>
        </div>
        <div id="gh-levelshot" class="map-levelshot"></div>
        <div id="gh-map-name" class="map-name"></div>
      </div>
      <div class="lb-table-wrap">
        <div id="gh-status" class="lb-status">Loading…</div>
        <table id="gh-table" class="lb-table" hidden>
          <thead>
            <tr>
              <th class="th-rank">RANK</th>
              <th>PLAYER</th>
              <th>BEST LAP</th>
              <th>GAP</th>
              <th>VEHICLE</th>
              <th>SET ON</th>
              <th>GHOST</th>
            </tr>
          </thead>
          <tbody id="gh-body"></tbody>
        </table>
        <p class="gh-note">Best lap ghost per player, track and vehicle. Race them in Q3Rally: start a <b>Ghost Race</b> and pick a ghost before the start.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- PLAYER PROFILE MODAL -->
<div id="profile-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>
  <div class="modal-panel">
    <button class="modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="profile-content" class="modal-content">Loading…</div>
  </div>
</div>

<!-- MATCH DETAIL MODAL -->
<div id="match-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>
  <div class="modal-panel">
    <button class="modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="match-content" class="modal-content">Loading…</div>
  </div>
</div>

<style is:global>
  /* TOP BAR */
  .top-bar { background: var(--black); border-bottom: 1px solid #222; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 36px; font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .top-bar-left { display: flex; align-items: center; gap: 10px; }
  .live-dot { width: 7px; height: 7px; background: var(--orange); border-radius: 50%; animation: pulse 2s infinite; }
  .top-bar-left span { color: var(--gray-light); }
  .top-bar-left span b { color: var(--white); }
  .top-bar-right { display: flex; align-items: center; gap: 16px; color: var(--gray); font-size: 10px; }
  .hl { color: var(--orange); }

  .weather-label { color: var(--orange); font-family: 'Share Tech Mono', monospace; font-size: 11px; }

  /* PAGE HEADER */
  .page-header { background-color: var(--dark); background-image: var(--stripe); padding: 56px 80px 52px; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #222; flex-wrap: wrap; gap: 32px; }
  .section-label { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 14px; }
  .section-label span { color: var(--orange); }
  .page-title { font-family: 'Barlow Condensed', sans-serif; font-size: clamp(64px, 8vw, 110px); font-weight: 900; line-height: 0.88; text-transform: uppercase; }
  .page-title .orange { color: var(--orange); font-style: italic; }
  .admin-link { margin-left: auto; align-self: center; padding: 12px 16px; color: var(--gray-light); font-family: 'Share Tech Mono', monospace; font-size: 11px; letter-spacing: 0.1em; white-space: nowrap; }
  .admin-link:hover { color: var(--orange); }
  .admin-link:focus-visible { outline: 2px solid var(--orange); outline-offset: -2px; }
  .page-header-stats { display: flex; gap: 40px; flex-wrap: wrap; align-items: flex-end; }
  .hstat { text-align: right; }
  .hstat-val { font-family: 'Barlow Condensed', sans-serif; font-size: 44px; font-weight: 900; line-height: 1; color: var(--white); }
  .hstat-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 4px; }

  /* MAIN TABS */
  .main-tabs { background: var(--dark2); border-bottom: 1px solid #1e1e1e; display: flex; padding: 0 80px; }
  .main-tab { font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gray); padding: 16px 24px; border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s; }
  .main-tab:hover { color: var(--orange); }
  .main-tab.active { color: var(--orange); border-bottom-color: var(--orange); }

  /* TAB PANELS */
  .tab-panel { display: none; background: var(--black); }
  .tab-panel.active { display: block; }

  /* LEADERBOARD TOOLBAR */
  .lb-toolbar { background: var(--dark); border-bottom: 1px solid #1a1a1a; padding: 0 80px; display: flex; align-items: stretch; justify-content: space-between; gap: 24px; }
  .mode-tabs-wrap { flex: 1; min-width: 0; overflow-x: auto; display: flex; align-items: center; }
  .mode-tabs { display: flex; gap: 0; }
  .mode-tab { font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gray); padding: 16px 20px; border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; white-space: nowrap; transition: color 0.15s, border-color 0.15s; }
  .mode-tab:hover { color: var(--white); }
  .mode-tab.active { color: var(--orange); border-bottom-color: var(--orange); }
  .ladder-filters { display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 8px; padding: 14px 0 14px 24px; border-left: 1px solid #1a1a1a; flex: 0 0 auto; }
  .source-toggle { display: flex; gap: 0; align-items: center; flex-wrap: wrap; }
  .src-btn { font-family: 'Share Tech Mono', monospace; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); padding: 5px 12px; border: 1px solid #252525; background: none; cursor: pointer; transition: color 0.15s, border-color 0.15s, background 0.15s; margin-left: -1px; }
  .src-btn.active { color: var(--orange); border-color: var(--orange); background: rgba(255,85,0,0.05); z-index: 1; position: relative; }

  /* LEADERBOARD BODY */
  .lb-body { display: grid; grid-template-columns: 200px 1fr; padding: 40px 80px; gap: 40px; }
  .map-panel { display: flex; flex-direction: column; gap: 10px; }
  .map-panel-label { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; }
  .map-select { background: var(--dark2); border: 1px solid #2a2a2a; color: var(--white); font-family: 'Share Tech Mono', monospace; font-size: 10px; padding: 8px 10px; width: 100%; letter-spacing: 0.05em; cursor: pointer; }
  .map-select:focus { outline: none; border-color: var(--orange); }
  .map-levelshot { height: 120px; background: #0d0d0d; background-image: var(--stripe); overflow: hidden; }
  .map-levelshot img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .map-name { font-family: 'Barlow Condensed', sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; color: var(--gray-light); letter-spacing: 0.04em; }
  .lb-status { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--gray); letter-spacing: 0.1em; padding: 40px 0; }
  .lb-table-wrap { overflow-x: auto; }
  .lb-table { width: 100%; border-collapse: collapse; }
  .lb-table th { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; text-align: left; padding: 10px 16px; border-bottom: 1px solid #1a1a1a; }
  .th-rank { width: 48px; }
  .lb-table td { font-family: 'Share Tech Mono', monospace; font-size: 12px; color: var(--gray-light); padding: 14px 16px; border-bottom: 1px solid #0f0f0f; }
  .lb-table tbody tr:hover td { background: rgba(255,255,255,0.02); }
  .lb-table td.td-rank { font-family: 'Barlow Condensed', sans-serif; font-size: 24px; font-weight: 900; color: var(--white); }
  .rank-1 .td-rank { color: var(--orange); }
  .rank-2 .td-rank { color: #b0b0b0; }
  .rank-3 .td-rank { color: #9a7040; }
  .player-link { color: inherit; cursor: pointer; }
  .player-link:hover { color: var(--orange); }

  /* GHOSTS */
  .gh-build-wrap { display: flex; flex-direction: column; gap: 10px; }
  .gh-build-wrap[hidden] { display: none !important; }
  .gh-note { font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.05em; color: var(--gray); margin: 18px 16px 0; line-height: 1.6; }
  .gh-note b { color: var(--orange); font-weight: 400; }
  .gh-dl { color: var(--orange); text-decoration: none; border-bottom: 1px solid transparent; }
  .gh-dl:hover { border-bottom-color: var(--orange); }
  .gh-gap { color: var(--gray); }

  /* RECENT ACTIVITY */
  .activity-wrap { padding: 40px 80px; }
  .activity-feed { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .activity-card { background: var(--dark2); border: 1px solid #1a1a1a; padding: 18px 24px; cursor: pointer; transition: border-color 0.15s; display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: start; }
  .activity-card:hover { border-color: #333; }
  .activity-card-left {}
  .activity-mode { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--orange); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 6px; }
  .activity-map { font-family: 'Barlow Condensed', sans-serif; font-size: 26px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1; margin-bottom: 8px; }
  .activity-winner { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray-light); }
  .activity-winner span { color: var(--orange); font-weight: 700; }
  .activity-players { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); margin-top: 4px; }
  .activity-card-right { text-align: right; }
  .activity-date { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); white-space: nowrap; }
  .activity-server { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: #3a3a3a; margin-top: 4px; white-space: nowrap; max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
  .activity-source { display: inline-block; font-family: 'Share Tech Mono', monospace; font-size: 8px; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 8px; margin-top: 6px; }
  .src-online { border: 1px solid #1f3a1f; color: #4a8a4a; }
  .src-offline { border: 1px solid #2a2a2a; color: #555; }
  .activity-section-label { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; padding: 20px 0 10px; }
  .activity-section-label:first-child { padding-top: 0; }

  /* PLAYER RANKINGS */
  .rankings-wrap { padding: 0; }
  .rankings-toolbar { padding: 16px 80px; background: var(--dark); border-bottom: 1px solid #1a1a1a; display: flex; align-items: center; gap: 16px; }
  .toolbar-input { background: var(--dark2); border: 1px solid #2a2a2a; color: var(--white); font-family: 'Share Tech Mono', monospace; font-size: 10px; padding: 8px 12px; letter-spacing: 0.08em; width: 200px; }
  .toolbar-input:focus { outline: none; border-color: var(--orange); }
  .toolbar-input::placeholder { color: #444; }
  .rankings-sort-btns { display: flex; gap: 0; margin-left: auto; }
  .sort-btn { font-family: 'Share Tech Mono', monospace; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); padding: 6px 14px; border: 1px solid #2a2a2a; background: none; cursor: pointer; margin-left: -1px; transition: color 0.15s, border-color 0.15s; }
  .sort-btn.active { color: var(--orange); border-color: var(--orange); z-index: 1; position: relative; }
  .rankings-table { width: 100%; border-collapse: collapse; }
  .rankings-table th { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; text-align: left; padding: 12px 80px 12px 16px; border-bottom: 1px solid #1a1a1a; background: var(--dark); }
  .rankings-table th:first-child { padding-left: 80px; width: 64px; }
  .rankings-table th:last-child { padding-right: 80px; }
  .rankings-table td { font-family: 'Share Tech Mono', monospace; font-size: 12px; color: var(--gray-light); padding: 14px 80px 14px 16px; border-bottom: 1px solid #0f0f0f; }
  .rankings-table td:first-child { padding-left: 80px; }
  .rankings-table td:last-child { padding-right: 80px; }
  .rankings-table tbody tr { cursor: pointer; transition: background 0.1s; }
  .rankings-table tbody tr:hover td { background: rgba(255,255,255,0.02); }
  .rankings-table td.td-rank { font-family: 'Barlow Condensed', sans-serif; font-size: 24px; font-weight: 900; color: var(--white); }
  .rankings-table tr:nth-child(1) .td-rank { color: var(--orange); }
  .rankings-table tr:nth-child(2) .td-rank { color: #b0b0b0; }
  .rankings-table tr:nth-child(3) .td-rank { color: #9a7040; }
  .td-player-name { font-family: 'Barlow Condensed', sans-serif; font-size: 20px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--white); }
  .td-player-rank { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--gray); letter-spacing: 0.08em; margin-top: 2px; }
  .td-highlight { color: var(--white); }
  .kd-positive { color: #5a9a5a; }
  .bot-badge { font-family: 'Share Tech Mono', monospace; font-size: 8px; letter-spacing: 0.12em; color: #555; border: 1px solid #2a2a2a; padding: 1px 5px; vertical-align: middle; margin-left: 4px; }

  /* MODALS */
  .modal { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-start; justify-content: center; padding: 40px 20px; transition: opacity 0.2s; overflow-y: auto; }
  .modal[aria-hidden="true"] { opacity: 0; pointer-events: none; }
  .modal[aria-hidden="false"] { opacity: 1; pointer-events: all; }
  .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.9); }
  .modal-panel { position: relative; z-index: 1; background: var(--dark); border: 1px solid #2a2a2a; width: 100%; max-width: 960px; padding: 40px; }
  .modal-close { position: absolute; top: 16px; right: 16px; background: rgba(20,20,20,0.8); border: 1px solid #2a2a2a; color: var(--gray-light); width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .modal-close:hover { border-color: var(--orange); color: var(--orange); }
  .modal-content { color: var(--gray-light); }

  /* PROFILE CONTENT */
  .pc-name { font-family: 'Barlow Condensed', sans-serif; font-size: 44px; font-weight: 900; text-transform: uppercase; line-height: 1; margin-bottom: 8px; }
  .pc-rank-bar { background: var(--dark2); border: 1px solid #222; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .pc-rank-name { font-family: 'Barlow Condensed', sans-serif; font-size: 17px; font-weight: 700; text-transform: uppercase; color: var(--gray-light); }
  .pc-score { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--orange); letter-spacing: 0.1em; }
  .pc-section { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--orange); letter-spacing: 0.15em; text-transform: uppercase; margin: 20px 0 10px; border-bottom: 1px solid #1a1a1a; padding-bottom: 6px; }
  .pc-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; }
  .pc-stat { background: var(--dark2); padding: 12px 14px; }
  .pc-stat-label { font-family: 'Share Tech Mono', monospace; font-size: 8px; color: var(--gray); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 4px; }
  .pc-stat-val { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 900; }
  .pc-mode-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }

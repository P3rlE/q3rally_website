    .sort-btn { flex: 1; text-align: center; }
    .rankings-table th { padding: 10px 8px 10px 8px; }
    .rankings-table th:first-child { padding-left: 16px; }
    .rankings-table th:last-child { padding-right: 16px; }
    .rankings-table td { padding: 12px 8px; font-size: 11px; }
    .rankings-table td:first-child { padding-left: 16px; }
    .rankings-table td:last-child { padding-right: 16px; }
    .td-player-name { font-size: 16px; }

    /* MODALS */
    .modal { padding: 0; align-items: flex-end; }
    .modal-panel { max-width: 100%; border-left: none; border-right: none; border-bottom: none; padding: 28px 20px 32px; max-height: 90vh; overflow-y: auto; }

    /* PROFILE */
    .pc-name { font-size: 32px; }
    .pc-grid { grid-template-columns: repeat(2, 1fr); }
    .ach-list { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ API_BASE, IMG_BASE }}>
const RANK_NAMES = [
  'Rookie Driver','Street Newbie','Weekend Racer','Track Learner',
  'Amateur Racer','Street Racer','Semi-Pro Driver','Pro Racer',
  'Elite Driver','Track Dominator','Master of Speed','Racing Legend',
  'Asphalt King','Grand Champion','Q3Rally Icon'
];
// Score thresholds from profile_shared.h — must mirror PROFILE_RANK_TABLE
const RANK_SCORE_THRESHOLDS = [0,50,150,350,700,1200,2000,3200,5000,7500,11000,16000,22000,30000,40000];
function rankNameFromScore(score) {
  let idx = 0;
  for (let i = 0; i < RANK_SCORE_THRESHOLDS.length; i++) {
    if ((score ?? 0) >= RANK_SCORE_THRESHOLDS[i]) idx = i;
  }
  return RANK_NAMES[idx];
}
const MODE_LABELS = {
  GT_RACING:'Racing', GT_RACING_DM:'Racing DM', GT_SPRINT:'Sprint',
  GT_TEAM_RACING:'Team Racing', GT_TEAM_RACING_DM:'Team Racing DM',
  GT_ELIMINATION:'Elimination', GT_LCS:'Last Car Standing',
  GT_DERBY:'Derby', GT_DEATHMATCH:'Deathmatch',
  GT_TEAM:'Team DM', GT_CTF:'CTF', GT_CTF4:'4-Team CTF',
  GT_DOMINATION:'Domination', GT_KOTH:'King of the Hill',
  GT_AUTOBALL:'Autoball', GT_GHOST:'Ghost Race', GT_SINGLE_PLAYER:'Single Player',
};
const RACE_MODES = new Set(['GT_RACING','GT_RACING_DM','GT_SPRINT','GT_TEAM_RACING','GT_TEAM_RACING_DM']);

let allMatches = [], mapMeta = {}, levelshotManifest = {};
let activeSrc = 'all', activeWeather = 'all', activeMode = '', activeMap = '';
let rankingsSort = 'wins', rankingsSearch = '';

// The index uses a string; the full match payload uses weather.condition.
// Older matches count as dry, matching the standalone Ladder.
function matchWeather(match) {
  const raw = typeof match?.weather === 'object' ? match.weather?.condition : match?.weather;
  const condition = String(raw || '').trim().toLowerCase();
  return ['wet', 'snow', 'mixed'].includes(condition) ? condition : 'dry';
}
function weatherLabel(match) {
  return { dry: 'Dry', wet: 'Wet', snow: 'Snow', mixed: 'Mixed' }[matchWeather(match)];
}
function matchesWeather(match, weather) {
  return weather === 'all' || matchWeather(match) === weather;
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function canonMode(raw) {
  if (!raw) return null;
  let m = String(raw).trim().toUpperCase().replace(/[\s-]+/g,'_');
  // Explicit backend sentinels are not playable leaderboard categories.
  if (['UNKNOWN', 'GT_UNKNOWN', '__UNKNOWN__', 'GT___UNKNOWN__'].includes(m)) return null;
  if (!m) return null;
  if (!m.startsWith('GT_')) m = 'GT_' + m;
  return m;
}
function modeLabel(m) {
  return MODE_LABELS[m] || m.replace(/^GT_/, '').replace(/_/g, ' ');
}
function matchDate(m) {
  const s = m.startTime || m.start_time || m.startedAt;
  if (!s) return null;
  const d = new Date(s); return isNaN(d) ? null : d;
}
function mapLabel(key) {
  if (!key) return '—';
  return mapMeta[key.toLowerCase()] || mapMeta[key] || key;
}
function levelshotUrl(mapKey) {
  const k = (mapKey || '').toLowerCase();
  const ext = levelshotManifest[k];
  return ext ? `${IMG_BASE}/${k}.${ext}` : null;
}
function fmtTime(ms) {
  if (ms == null || ms === 0) return '—';
  const n = typeof ms === 'string' ? parseFloat(ms) : ms;
  if (isNaN(n) || n <= 0) return '—';
  const totalSec = n / 1000;
  const min = Math.floor(totalSec / 60);
  const sec = (totalSec % 60).toFixed(3).padStart(6, '0');
  return min > 0 ? `${min}:${sec}` : `${sec}s`;
}
function fmtDate(d) {
  if (!d) return '—';
  return d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' });
}
function fmtDateShort(d) {
  if (!d) return '—';
  const now = new Date();
  const diffH = (now - d) / 3600000;
  if (diffH < 1) return `${Math.round(diffH * 60)}m ago`;
  if (diffH < 24) return `${Math.round(diffH)}h ago`;
  return d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
}
function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function getWinner(m) {
  const players = (m.players || []).filter(p => !p.isBot);
  if (!players.length) return null;
  const mode = canonMode(m.mode || m.gametype || '');
  if (RACE_MODES.has(mode)) {
    const byLap = players.filter(p => p.bestLapMs > 0).sort((a,b) => a.bestLapMs - b.bestLapMs);
    return byLap[0]?.name || players.sort((a,b) => (a.position||99)-(b.position||99))[0]?.name || null;
  }
  return players.sort((a,b) => (b.score||0)-(a.score||0))[0]?.name || null;
}

// ── Init ─────────────────────────────────────────────────────────────────────
async function init() {
  setupTabs();
  await Promise.all([fetchMatches(), fetchMapMeta(), fetchLevelshots()]);
  buildModeTabs();
  renderLeaderboard();
  renderActivity();
  renderRankings();
}

async function fetchMatches() {
  try {
    const r = await fetch(`${API_BASE}/matches/index`);
    const d = await r.json();
    allMatches = d.matches || [];
  } catch(e) { allMatches = []; }
}
async function fetchMapMeta() {
  try { const r = await fetch(`${API_BASE}/maps/metadata`); const d = await r.json(); mapMeta = d.maps || {}; } catch(_) {}
}
async function fetchLevelshots() {
  try { const r = await fetch(`${API_BASE}/maps/levelshots`); levelshotManifest = await r.json(); } catch(_) {}
}

// ── Header ────────────────────────────────────────────────────────────────────
function updateHeader() {
  const players = new Set(), modes = new Set();
  let last = null;
  for (const m of allMatches) {
    const mode = canonMode(m.mode || m.gametype || '');
    if (mode) modes.add(mode);
    (m.players || []).forEach(p => p.name && players.add(p.name));
    const d = matchDate(m);
    if (d && (!last || d > last)) last = d;
  }
  const fmt = n => n.toLocaleString('de-DE');
  document.getElementById('hs-matches').textContent = fmt(allMatches.length);
  document.getElementById('hs-players').textContent = fmt(players.size);
  document.getElementById('hs-modes').textContent = fmt(modes.size);
  document.getElementById('hs-updated').textContent = last ? fmtDateShort(last) : '—';
  document.getElementById('tb-matches').textContent = fmt(allMatches.length);
  document.getElementById('tb-players').textContent = fmt(players.size);
}

// ── Tabs ──────────────────────────────────────────────────────────────────────
function setupTabs() {
  document.querySelectorAll('.main-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.main-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });
  document.querySelectorAll('.src-btn[data-src]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.src-btn[data-src]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeSrc = btn.dataset.src;
      renderLeaderboard();
    });
  });
}

document.querySelectorAll('.weather-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    activeWeather = btn.dataset.weather;
    document.querySelectorAll('.weather-btn').forEach(b => {
      const selected = b === btn;
      b.classList.toggle('active', selected);
      b.setAttribute('aria-pressed', String(selected));
    });
    renderLeaderboard();
  });
});

// ── Mode tabs ─────────────────────────────────────────────────────────────────
function buildModeTabs() {
  updateHeader();
  const modeSet = new Set();
  for (const m of allMatches) {
    const mode = canonMode(m.mode || m.gametype || '');
    if (mode) modeSet.add(mode);
  }
  const modes = [...modeSet];
  if (!modes.length) return;
  if (!activeMode) activeMode = modes[0];

  const container = document.getElementById('mode-tabs');
  container.innerHTML = '';
  modes.forEach(mode => {
    const btn = document.createElement('button');
    btn.className = 'mode-tab' + (mode === activeMode ? ' active' : '');
    btn.textContent = modeLabel(mode);
    btn.dataset.mode = mode;
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mode-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeMode = mode;
      activeMap = '';
      renderLeaderboard();
    });
    container.appendChild(btn);
  });
}

// ── Leaderboard ───────────────────────────────────────────────────────────────
function getFiltered() {
  return allMatches.filter(m => {
    if (activeSrc === 'online' && m.source === 'offline') return false;
    if (activeSrc === 'offline' && m.source !== 'offline') return false;
    return matchesWeather(m, activeWeather);
  });
}

function renderLeaderboard() {
  if (!activeMode) { document.getElementById('lb-status').textContent = 'No data.'; return; }
  const filtered = getFiltered().filter(m => canonMode(m.mode || m.gametype || '') === activeMode);

  const mapSet = new Set();
  for (const m of filtered) { const map = m.map || ''; if (map) mapSet.add(map); }
  const maps = [...mapSet].sort();
  if (!maps.length) {
    document.getElementById('lb-status').textContent = 'No matches for this mode.';
    document.getElementById('lb-status').style.display = '';
    document.getElementById('lb-table').hidden = true;
    return;
  }
  if (!activeMap || !maps.includes(activeMap)) activeMap = maps[0];

  // Map selector
  const sel = document.getElementById('map-select');
  sel.innerHTML = '';
  maps.forEach(map => {
    const opt = document.createElement('option');
    opt.value = map;
    opt.textContent = mapLabel(map);
    if (map === activeMap) opt.selected = true;
    sel.appendChild(opt);
  });
  sel.onchange = () => { activeMap = sel.value; renderLeaderboard(); };

  // Levelshot
  const lsUrl = levelshotUrl(activeMap);
  const lsDiv = document.getElementById('map-levelshot');
  lsDiv.innerHTML = lsUrl ? `<img src="${lsUrl}" alt="${esc(activeMap)}" loading="lazy" />` : '';
  document.getElementById('map-name').textContent = mapLabel(activeMap);

  const isRace = RACE_MODES.has(activeMode);
  const best = new Map();

  for (const match of filtered) {
    if ((match.map || '').toLowerCase() !== activeMap.toLowerCase()) continue;
    const date = matchDate(match);
    for (const p of (match.players || [])) {
      const name = p.name || p.displayName || '';
      if (!name) continue;
      if (isRace) {
        const lapMs = p.bestLapMs || p.totalRaceMs || 0;
        if (!lapMs) continue;
        const ex = best.get(name);
        if (!ex || lapMs < ex.val) best.set(name, { val: lapMs, vehicle: p.vehicle||p.car||'—', date, matchId: match.matchId, isBot: !!p.isBot });
      } else {
        const score = p.score || p.rawScore || 0;
        const ex = best.get(name);
        if (!ex || score > ex.val) best.set(name, { val: score, kills: p.kills||0, deaths: p.deaths||0, vehicle: p.vehicle||p.car||'—', date, matchId: match.matchId, isBot: !!p.isBot });
      }
    }
  }

  let entries = [...best.entries()].map(([name, d]) => ({ name, ...d }));
  entries.sort((a,b) => isRace ? a.val - b.val : b.val - a.val);
  entries = entries.slice(0,10);

  document.getElementById('lb-status').style.display = 'none';
  const table = document.getElementById('lb-table');
  table.hidden = false;
  document.getElementById('lb-col3').textContent = isRace ? 'BEST LAP' : 'SCORE';

  const tbody = document.getElementById('lb-body');
  tbody.innerHTML = entries.map((e,i) => `
    <tr class="rank-${i+1}">
      <td class="td-rank">${i+1}</td>
      <td><span class="player-link" data-player="${esc(e.name)}" data-player-id="${esc(e.playerId||'')}">${esc(e.name)}</span>${e.isBot ? ' <span class="bot-badge">BOT</span>' : ''}</td>
      <td>${isRace ? fmtTime(e.val) : e.val}</td>
      <td>${esc(e.vehicle)}</td>
      <td>${fmtDate(e.date)}</td>
    </tr>
  `).join('');

  tbody.querySelectorAll('.player-link').forEach(el =>
    el.addEventListener('click', () => openProfile(el.dataset.playerId || el.dataset.player, el.dataset.player))
  );
}

// ── Recent Activity ───────────────────────────────────────────────────────────
function renderActivity() {
  const sorted = [...allMatches].sort((a,b) => {
    const da = matchDate(a), db = matchDate(b);
    if (!da && !db) return 0; if (!da) return 1; if (!db) return -1;
    return db - da;
  });
  const recent = sorted.slice(0, 15);

  const feed = document.getElementById('activity-feed');
  if (!recent.length) { feed.innerHTML = '<div class="lb-status">No matches yet.</div>'; return; }

  feed.innerHTML = recent.map(m => {
    const mode = canonMode(m.mode || m.gametype || '');
    const map = m.map || '';
    const date = matchDate(m);
    const winner = getWinner(m);
    const humanPlayers = (m.players || []).filter(p => !p.isBot);
    const names = humanPlayers.slice(0,4).map(p => esc(p.name||'')).join(', ')
      + (humanPlayers.length > 4 ? ` +${humanPlayers.length-4}` : '');
    const srcClass = m.source === 'offline' ? 'src-offline' : 'src-online';
    const srcLabel = m.source === 'offline' ? 'offline' : 'online';
    const server = m.serverName || '';

    return `<div class="activity-card" data-match-id="${esc(m.matchId||'')}">
      <div class="activity-card-left">
        <div class="activity-mode">${esc(mode ? modeLabel(mode) : 'Unclassified')}</div>
        <div class="activity-map">${esc(mapLabel(map) || map || '—')}</div>
        <div class="weather-label">Weather: ${weatherLabel(m)}</div>
        ${winner ? `<div class="activity-winner">Winner: <span>${esc(winner)}</span></div>` : ''}
        <div class="activity-players">${names}</div>
      </div>
      <div class="activity-card-right">
        <div class="activity-date">${fmtDateShort(date)}</div>
        ${server ? `<div class="activity-server">${esc(server)}</div>` : ''}
        <div><span class="activity-source ${srcClass}">${srcLabel}</span></div>
      </div>
    </div>`;
  }).join('');

  feed.querySelectorAll('.activity-card').forEach(card => {
    card.addEventListener('click', () => openMatch(card.dataset.matchId));
  });
}

// ── Player Rankings ───────────────────────────────────────────────────────────
const TEAM_MODES = new Set([
  'GT_TEAM','GT_TEAM_RACING','GT_TEAM_RACING_DM',
  'GT_CTF','GT_CTF4','GT_DOMINATION','GT_KOTH'
]);

function buildPlayerStats() {
  const map = new Map();
  // The newest available career snapshot wins, including decreases in score.
  const chronological = [...allMatches].sort((a, b) => (matchDate(a)?.getTime() || 0) - (matchDate(b)?.getTime() || 0));
  for (const m of chronological) {
    const mode = canonMode(m.mode || m.gametype || '');
    const isRace = RACE_MODES.has(mode);
    const isTeamMode = TEAM_MODES.has(mode);
    const players = (m.players || []).filter(p => p.name);

    // Use server-provided winner from index (most accurate).
    // For team modes: winnerTeam (int) → all players with p.team === winnerTeam get a win.
    // For individual modes: winner (string) → named player gets a win.
    // Fall back to stat-derived winner for legacy index entries that lack these fields.
    let winnerName = m.winner || null;
    const winnerTeam = m.winnerTeam || 0;

    if (!winnerName && !isTeamMode) {
      if (isRace) {
        const byLap = players.filter(p => (p.bestLapMs || 0) > 0).sort((a,b) => a.bestLapMs - b.bestLapMs);
        winnerName = byLap[0]?.name
          || [...players].sort((a,b) => (a.position||99)-(b.position||99))[0]?.name
          || null;
      } else {
        winnerName = [...players].sort((a,b) => (b.score||0)-(a.score||0))[0]?.name || null;
      }
    }

    for (const p of players) {
      const name = p.name;
      const key = p.playerId || name;
      if (!map.has(key)) map.set(key, { name, playerId: p.playerId || '', wins:0, matches:0, kills:0, deaths:0, bestLapMs:0, isBot: !!p.isBot, achievementTiers: null, playerScore: 0 });
      const s = map.get(key);
      s.name = name;
      s.matches++;
      s.kills += p.kills || 0;
      s.deaths += p.deaths || 0;
      // Keep the first non-empty playerId seen for this name
      if (!s.playerId && p.playerId) s.playerId = p.playerId;
      const isWinner = isTeamMode
        ? (winnerTeam > 0 && p.team === winnerTeam)
        : (winnerName && name === winnerName);
      if (isWinner) s.wins++;
      const lap = p.bestLapMs || p.totalRaceMs || 0;
      if (lap > 0 && (s.bestLapMs === 0 || lap < s.bestLapMs)) s.bestLapMs = lap;
      const tiers = p.achievementTiers;
      if (Array.isArray(tiers) && tiers.length > 0) s.achievementTiers = tiers;
      const score = Number(p.playerScore);
      if (p.playerScore != null && Number.isFinite(score)) s.playerScore = Math.max(0, score);
    }
  }
  return [...map.values()];
}

function renderRankings() {
  let players = buildPlayerStats();
  if (rankingsSearch) players = players.filter(p => p.name.toLowerCase().includes(rankingsSearch));

  players.sort((a,b) => {
    if (rankingsSort === 'wins')    return b.wins - a.wins || b.matches - a.matches;
    if (rankingsSort === 'matches') return b.matches - a.matches;
    if (rankingsSort === 'kills')   return b.kills - a.kills;
    if (rankingsSort === 'kd') {
      const kdA = a.deaths ? a.kills / a.deaths : a.kills;
      const kdB = b.deaths ? b.kills / b.deaths : b.kills;
      return kdB - kdA;
    }
    return 0;
  });

  const tbody = document.getElementById('rankings-body');
  if (!players.length) { tbody.innerHTML = `<tr><td colspan="8" style="padding:40px 80px;color:var(--gray)">No players found.</td></tr>`; return; }

  tbody.innerHTML = players.map((p, i) => {
    const kd = p.deaths ? (p.kills / p.deaths).toFixed(2) : p.kills.toFixed(2);
    const kdClass = parseFloat(kd) >= 1 ? 'kd-positive' : '';
    const rankName = rankNameFromScore(p.playerScore ?? 0);
    return `<tr data-player="${esc(p.name)}" data-player-id="${esc(p.playerId||'')}">
      <td class="td-rank">${i+1}</td>
      <td>
        <div class="td-player-name">${esc(p.name)}${p.isBot ? ' <span class="bot-badge">BOT</span>' : ''}</div>
        <div class="td-player-rank">${rankName}</div>
      </td>
      <td class="td-highlight">${p.wins}</td>
      <td>${p.matches}</td>
      <td>${p.kills}</td>
      <td>${p.deaths}</td>
      <td class="${kdClass}">${kd}</td>
      <td>${p.bestLapMs ? fmtTime(p.bestLapMs) : '—'}</td>
    </tr>`;
  }).join('');

  tbody.querySelectorAll('tr').forEach(row => {
    row.addEventListener('click', () => openProfile(row.dataset.playerId || row.dataset.player, row.dataset.player));
  });
}

// Sort + search controls
document.getElementById('rankings-search').addEventListener('input', e => {
  rankingsSearch = e.target.value.toLowerCase();
  renderRankings();
});
document.querySelectorAll('.sort-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    rankingsSort = btn.dataset.sort;
    renderRankings();
  });
});

// ── Profile modal ─────────────────────────────────────────────────────────────
// playerId = UUID for API lookup; name = display name for fallback
async function openProfile(playerId, name) {
  if (!name) name = playerId; // backwards-compat when called with name only
  openModal('profile-modal');
  const content = document.getElementById('profile-content');
  content.innerHTML = '<div class="lb-status">Loading…</div>';
  try {
    // Use UUID if available, otherwise fall back to display name —
    // PHP will scan profiles by cleanName when no UUID file matches.
    const lookupKey = playerId || name;
    if (!lookupKey) throw new Error('no id');
    const r = await fetch(`${API_BASE}/players/${encodeURIComponent(lookupKey)}`);
    if (!r.ok) throw new Error('not found');
    const p = await r.json();
    content.innerHTML = buildProfileHTML(p);
  } catch(_) {
    // Build from local match data
    const stats = buildPlayerStats().find(p => p.name.toLowerCase() === name.toLowerCase());
    if (stats) {
      content.innerHTML = buildSimpleProfile(stats);
    } else {
      content.innerHTML = `<div class="lb-status">No profile found for "${esc(name)}".</div>`;
    }
  }
}

const ACHIEVEMENTS = [
  { name: 'Distance Driven', icon: 'road' },
  { name: 'Kills',           icon: 'skull' },
  { name: 'Races Won',       icon: 'trophy' },
  { name: 'Sprint Wins',     icon: 'bolt' },
  { name: 'Flags Captured',  icon: 'flag' },
  { name: 'Flag Assists',    icon: 'flag-2' },
  { name: 'Fuel Consumed',   icon: 'gas-station' },
  { name: 'Accuracy',        icon: 'target' },
  { name: 'Excellent',       icon: 'star' },
  { name: 'Impressive',      icon: 'award' },
  { name: 'Perfect',         icon: 'crown' },
];
const ACHIEVEMENT_MAX = 8;

function buildAchievementsHTML(tiers) {
  if (!tiers || !tiers.length) return '';
  const rows = ACHIEVEMENTS.map((a, i) => {
    const tier = tiers[i] ?? 0;
    const pct = Math.round((tier / ACHIEVEMENT_MAX) * 100);
    const locked = tier === 0;
    const color = locked ? '#333' : (i % 3 === 0 ? '#00bcd4' : i % 3 === 1 ? 'var(--orange)' : '#a855f7');
    return `<div class="ach-row${locked ? ' ach-locked' : ''}">
      <div class="ach-icon">
        <svg viewBox="0 0 32 32" width="26" height="26">
          <circle cx="16" cy="16" r="12" fill="none" stroke="#2a2a2a" stroke-width="2.5"/>
          ${!locked ? `<circle cx="16" cy="16" r="12" fill="none" stroke="${color}" stroke-width="2.5"
            stroke-dasharray="${Math.round(pct * 0.754)} 100"
            stroke-linecap="round" transform="rotate(-90 16 16)"/>` : ''}
        </svg>
      </div>
      <div class="ach-mid">
        <div class="ach-name">${locked ? 'Locked' : a.name}</div>
        <div class="ach-bar"><div class="ach-fill" style="width:${pct}%;background:${color};"></div></div>
      </div>
      <div class="ach-tier">${locked ? '<span class="ach-locked-label">—</span>' : `<span class="ach-tier-val">${tier}</span><span class="ach-tier-max">/${ACHIEVEMENT_MAX}</span>`}</div>
    </div>`;
  }).join('');
  return `<div class="pc-section">ACHIEVEMENTS</div><div class="ach-list">${rows}</div>`;
}

function buildSimpleProfile(s) {
  const kd = s.deaths ? (s.kills/s.deaths).toFixed(2) : s.kills.toFixed(2);
  const rankName = rankNameFromScore(s.playerScore ?? 0);
  return `<div class="pc-name">${esc(s.name)}</div>
  <div class="pc-rank-bar">
    <span class="pc-rank-name">${rankName}</span>
    ${s.playerScore ? `<span class="pc-score">SCORE ${s.playerScore}</span>` : ''}
  </div>
  <div class="pc-section">CAREER STATS</div>
  <div class="pc-grid">
    <div class="pc-stat"><div class="pc-stat-label">Wins</div><div class="pc-stat-val">${s.wins}</div></div>
    <div class="pc-stat"><div class="pc-stat-label">Matches</div><div class="pc-stat-val">${s.matches}</div></div>
    <div class="pc-stat"><div class="pc-stat-label">Kills</div><div class="pc-stat-val">${s.kills}</div></div>
    <div class="pc-stat"><div class="pc-stat-label">Deaths</div><div class="pc-stat-val">${s.deaths}</div></div>
    <div class="pc-stat"><div class="pc-stat-label">K/D</div><div class="pc-stat-val">${kd}</div></div>
    ${s.bestLapMs ? `<div class="pc-stat"><div class="pc-stat-label">Best Lap</div><div class="pc-stat-val">${fmtTime(s.bestLapMs)}</div></div>` : ''}
  </div>
  ${buildAchievementsHTML(s.achievementTiers)}`;
}

function buildProfileHTML(p) {
  // Profile JSON is flat — no careerStats/career sub-object.
  // Fall back to p itself so all root-level fields are accessible.
  const career = p.careerStats || p.career || p;
  const modeStats = p.modeStats || p.modes || {};
  const playerScore = p.playerScore ?? career.playerScore ?? p.score ?? p.totalScore;
  const hasScore = playerScore != null && Number.isFinite(Number(playerScore));
  const rankName = hasScore ? rankNameFromScore(Number(playerScore))
    : (RANK_NAMES[p.currentRank] || 'Rookie Driver');
  const score = hasScore ? Math.max(0, Number(playerScore)) : '—';
  const sv = v => (v != null && v !== '') ? v : '—';

  // Compute K/D from root fields (not stored pre-computed in profile JSON)
  const kd = (() => {
    const k = career.kills ?? 0;
    const d = career.deaths ?? 0;
    if (!k && !d) return null;
    if (!d) return k + '/0';
    return (k / d).toFixed(2);
  })();

  const stats = [
    ['Wins', career.wins], ['Losses', career.losses],
    ['Kills', career.kills], ['Deaths', career.deaths],
    ['K/D', kd], ['Games', career.gamesPlayed],
    // PHP stores bestLapMs (already in ms), distanceKm, topSpeedKph, fuelUsed
    ['Best Lap', career.bestLapMs ? fmtTime(career.bestLapMs) : null],
    ['Distance', career.distanceKm ? (Math.round(career.distanceKm * 10) / 10) + ' km' : null],
    ['Top Speed', career.topSpeedKph ? (Math.round(career.topSpeedKph * 10) / 10) + ' km/h' : null],
    ['Fuel Used', career.fuelUsed ? (Math.round(career.fuelUsed * 10) / 10) + ' L' : null],
    ['Most Used', career.mostUsedVehicle],
    ['Flag Caps', career.flagCaptures || null], ['Flag Assists', career.flagAssists || null],
    ['Dmg Dealt', career.damageDealt || null], ['Dmg Taken', career.damageTaken || null],
  ].map(([label, val]) =>
    `<div class="pc-stat"><div class="pc-stat-label">${label}</div><div class="pc-stat-val">${esc(sv(val))}</div></div>`
  ).join('');

  const modes = Object.entries(modeStats).map(([key, ms]) => {
    const isRace = RACE_MODES.has(key);
    const third = isRace ? ['Best Lap', ms.bestTime ? fmtTime(ms.bestTime) : null]
                         : ['Kills', ms.kills];
    return `<div class="pc-mode">
      <div class="pc-mode-name">${esc(modeLabel(key))}</div>
      <div class="pc-mode-stats">
        <div><div class="pc-ms-label">Wins</div><div class="pc-ms-val">${sv(ms.wins)}</div></div>
        <div><div class="pc-ms-label">Played</div><div class="pc-ms-val">${sv(ms.completed||ms.played)}</div></div>
        <div><div class="pc-ms-label">${third[0]}</div><div class="pc-ms-val">${sv(third[1])}</div></div>
      </div>
    </div>`;
  }).join('');

  const tiers = p.achievementTiers || career.achievementTiers || [];

  return `<div class="pc-name">${esc(p.displayName||p.cleanName||p.name||p.playerId||'—')}</div>
  <div class="pc-rank-bar">
    <span class="pc-rank-name">${rankName}</span>
    <span class="pc-score">SCORE ${score}</span>
  </div>
  <div class="pc-section">CAREER STATS</div>
  <div class="pc-grid">${stats}</div>
  ${modes ? `<div class="pc-section">MODE STATS</div><div class="pc-mode-grid">${modes}</div>` : ''}
  ${buildAchievementsHTML(tiers)}`;
}

// ── Match modal ───────────────────────────────────────────────────────────────
async function openMatch(matchId) {
  if (!matchId) return;
  openModal('match-modal');
  const content = document.getElementById('match-content');
  content.innerHTML = '<div class="lb-status">Loading…</div>';
  try {
    const r = await fetch(`${API_BASE}/matches/${encodeURIComponent(matchId)}`);
    if (!r.ok) throw new Error('not found');
    const m = await r.json();
    const mode = canonMode(m.mode || m.gametype || '');
    const isRace = RACE_MODES.has(mode);
    const map = m.map || '';
    const date = matchDate(m);
    const players = [...(m.players||[])].sort((a,b) => {
      if (isRace) { const ta = a.bestLapMs||a.totalRaceMs||99999999, tb = b.bestLapMs||b.totalRaceMs||99999999; return ta-tb; }
      return (b.score||0)-(a.score||0);
    });
    const rows = players.map((p,i) => `<tr>
      <td>${i+1}</td>
      <td class="md-player-link" data-player="${esc(p.name||'')}" data-player-id="${esc(p.playerId||'')}">${esc(p.name||'—')}${p.isBot?' <span style="color:#444;font-size:9px">BOT</span>':''}</td>
      <td>${isRace ? fmtTime(p.bestLapMs||p.totalRaceMs||0) : (p.score||0)}</td>
      <td>${p.kills||0}</td><td>${p.deaths||0}</td>
      <td>${esc(p.vehicle||'—')}</td>
    </tr>`).join('');
    content.innerHTML = `<div class="md-header">
      <div class="md-mode">${esc(mode ? modeLabel(mode) : 'Unclassified')}</div>
      <div class="md-map">${esc(mapLabel(map)||map||'—')}</div>
      <div class="md-meta">
        <span>${fmtDate(date)}</span>
        <span class="weather-label">Weather: ${weatherLabel(m)}</span>
        ${m.serverName ? `<span>${esc(m.serverName)}</span>` : ''}
        <span style="color:#333;font-size:9px">${esc(matchId)}</span>
      </div>
    </div>
    <table class="md-table">
      <thead><tr><th>#</th><th>PLAYER</th><th>${isRace?'BEST LAP':'SCORE'}</th><th>K</th><th>D</th><th>VEHICLE</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
    content.querySelectorAll('.md-player-link').forEach(el => {
      el.addEventListener('click', () => { closeModal('match-modal'); openProfile(el.dataset.playerId || el.dataset.player, el.dataset.player); });
    });
  } catch(_) {
    content.innerHTML = '<div class="lb-status">Could not load match.</div>';
  }
}

// ── Modal helpers ─────────────────────────────────────────────────────────────
function openModal(id) {
  document.getElementById(id).setAttribute('aria-hidden','false');
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).setAttribute('aria-hidden','true');
  document.body.style.overflow = '';
}

document.querySelectorAll('.modal-close').forEach(btn => {
  btn.addEventListener('click', () => closeModal(btn.closest('.modal').id));
});
document.querySelectorAll('.modal-backdrop').forEach(bd => {
  bd.addEventListener('click', () => closeModal(bd.closest('.modal').id));
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeModal('profile-modal'); closeModal('match-modal'); }
});

// ── Ghost rankings (tab GHOSTS) ───────────────────────────────────────────────
// GET /ghosts/catalog → maps / track variants / map builds / vehicles,
// GET /ghosts?map=&tl=&rev=&physics=&checksum=[&vehicle=] → ranking.
const GH_LENGTHS = ['Short', 'Medium', 'Long'];
const gh = { catalog: null, loading: false, error: '', map: '', variant: '', bucket: '', vehicle: '', lists: new Map() };

function ghVariantLabel(v) {
  return (GH_LENGTHS[v.trackLength] || 'Medium') + (v.trackReversed ? ' · Reversed' : '');
}
function ghMap() { return (gh.catalog || []).find(m => m.map === gh.map) || null; }
function ghVariant() { const m = ghMap(); return m ? (m.variants.find(v => v.variant === gh.variant) || null) : null; }
function ghBucket() { const v = ghVariant(); return v ? (v.buckets.find(b => b.bucket === gh.bucket) || null) : null; }
function ghNormalize() {
  const maps = gh.catalog || [];
  if (!maps.some(m => m.map === gh.map)) gh.map = maps.length ? maps[0].map : '';
  const m = ghMap();
  const variants = m ? m.variants : [];
  if (!variants.some(v => v.variant === gh.variant)) {
    const most = [...variants].sort((a, b) => b.count - a.count)[0];
    gh.variant = most ? most.variant : '';
  }
  const v = ghVariant();
  const buckets = v ? v.buckets : [];
  if (!buckets.some(b => b.bucket === gh.bucket)) gh.bucket = buckets.length ? buckets[0].bucket : '';  // current build first
  const b = ghBucket();
  if (gh.vehicle && !(b && b.vehicles[gh.vehicle])) gh.vehicle = '';
}
function ghFill(sel, options, value) {
  sel.innerHTML = options.map(o => `<option value="${esc(o.value)}">${esc(o.label)}</option>`).join('');
  sel.value = value;
  sel.onchange = () => { gh[sel.dataset.key] = sel.value; ghNormalize(); renderGhosts(); };
}
function ghStatus(text) {
  const st = document.getElementById('gh-status');
  st.textContent = text;
  st.style.display = '';
  document.getElementById('gh-table').hidden = true;
}
async function loadGhostCatalog() {
  if (gh.catalog || gh.loading) return;
  gh.loading = true;
  ghStatus('Loading…');
  try {
    const r = await fetch(`${API_BASE}/ghosts/catalog`);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    gh.catalog = Array.isArray(d.maps) ? d.maps : [];
  } catch (e) {
    gh.error = 'Could not load ghosts.';
  }
  gh.loading = false;
  ghNormalize();
  renderGhosts();
}
function ghListKey() { return [gh.map, gh.variant, gh.bucket, gh.vehicle].join('|'); }
async function loadGhostList() {
  const key = ghListKey(), v = ghVariant(), b = ghBucket();
  if (!v || !b || gh.lists.has(key)) return;
  gh.lists.set(key, { loading: true, ghosts: [] });
  const q = new URLSearchParams({ map: gh.map, tl: v.trackLength, rev: v.trackReversed,
    physics: b.physicsVersion, checksum: b.mapChecksum, limit: 100 });
  if (gh.vehicle) q.set('vehicle', gh.vehicle);
  try {
    const r = await fetch(`${API_BASE}/ghosts?${q}`);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    gh.lists.set(key, { loading: false, ghosts: d.ghosts || [] });
  } catch (e) {
    gh.lists.set(key, { loading: false, ghosts: [], error: true });
  }
  if (ghListKey() === key) renderGhosts();
}
function renderGhosts() {
  if (!gh.catalog) { ghStatus(gh.error || 'Loading…'); return; }
  const maps = gh.catalog, m = ghMap(), v = ghVariant(), b = ghBucket();
  const mapSel = document.getElementById('gh-map'), varSel = document.getElementById('gh-variant'), buildSel = document.getElementById('gh-build');
  mapSel.dataset.key = 'map'; varSel.dataset.key = 'variant'; buildSel.dataset.key = 'bucket';
  ghFill(mapSel, maps.map(x => ({ value: x.map, label: mapLabel(x.map) })), gh.map);
  ghFill(varSel, (m ? m.variants : []).map(x => ({ value: x.variant, label: `${ghVariantLabel(x)} (${x.count})` })), gh.variant);
  const buckets = v ? v.buckets : [];
  ghFill(buildSel, buckets.map((x, i) => ({ value: x.bucket,
    label: i === 0 ? 'Current'
                   : `Older · ${fmtDateShort(x.lastReceivedAt ? new Date(x.lastReceivedAt) : null)}`,
    })), gh.bucket);
  document.getElementById('gh-build-wrap').hidden = buckets.length < 2;

  // Vehicle filter in the toolbar, like the game mode tabs
  const tabs = document.getElementById('gh-vehicle-tabs');
  const vehicles = b ? Object.keys(b.vehicles) : [];
  tabs.innerHTML = [['', 'All vehicles', b ? b.count : 0], ...vehicles.map(x => [x, x, b.vehicles[x]])]
    .map(([key, label, n]) => `<button class="mode-tab${key === gh.vehicle ? ' active' : ''}" data-vehicle="${esc(key)}">${esc(label)} (${n})</button>`).join('');
  tabs.querySelectorAll('.mode-tab').forEach(btn => btn.addEventListener('click', () => {
    gh.vehicle = btn.dataset.vehicle; renderGhosts();
  }));

  const lsUrl = m ? levelshotUrl(m.map) : null;
  document.getElementById('gh-levelshot').innerHTML = lsUrl ? `<img src="${lsUrl}" alt="${esc(m.map)}" loading="lazy" />` : '';
  document.getElementById('gh-map-name').textContent = m ? mapLabel(m.map) : '';

  if (!maps.length || !b) { ghStatus('No ghosts yet.'); return; }
  const list = gh.lists.get(ghListKey());
  if (!list) loadGhostList();
  if (!list || list.loading) { ghStatus('Loading…'); return; }
  if (list.error) { ghStatus('Could not load ghosts.'); return; }
  if (!list.ghosts.length) { ghStatus('No ghosts for this selection yet.'); return; }

  document.getElementById('gh-status').style.display = 'none';
  document.getElementById('gh-table').hidden = false;
  const best = list.ghosts[0].lapMs;
  const tbody = document.getElementById('gh-body');
  tbody.innerHTML = list.ghosts.map((g, i) => `
    <tr class="rank-${i + 1}">
      <td class="td-rank">${i + 1}</td>
      <td><span class="player-link" data-player="${esc(g.playerName || '')}" data-player-id="${esc(g.playerId || '')}">${esc(g.playerName || '—')}</span></td>
      <td>${fmtTime(g.lapMs)}</td>
      <td class="gh-gap">${i === 0 ? '—' : '+' + ((g.lapMs - best) / 1000).toFixed(3)}</td>
      <td>${esc(g.vehicle || '—')}</td>
      <td>${fmtDateShort(g.receivedAt ? new Date(g.receivedAt) : null)}</td>
      <td><a class="gh-dl" href="${API_BASE}/ghosts/${encodeURIComponent(g.ghostId)}?format=raw&download=1" title="Download ghost file">.ghost</a></td>
    </tr>`).join('');
  tbody.querySelectorAll('.player-link').forEach(el =>
    el.addEventListener('click', () => openProfile(el.dataset.playerId || el.dataset.player, el.dataset.player))
  );
}
document.querySelector('.main-tab[data-tab="ghosts"]').addEventListener('click', () => {
  if (location.hash !== '#ghosts') history.replaceState(null, '', '#ghosts');
  if (gh.catalog) renderGhosts(); else loadGhostCatalog();
});

// init() registers the tab handlers synchronously before its first await.
const ladderReady = init();
// Deep link: www.q3rally.com/ladder/#ghosts
if (location.hash === '#ghosts') {
  document.querySelector('.main-tab[data-tab="ghosts"]').click();
}
// Map names and levelshots arrive with init(); refresh the ghost tab then.
ladderReady.then(() => { if (gh.catalog) renderGhosts(); });
</script>

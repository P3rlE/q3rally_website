    /* MAIN TABS */
    .main-tabs { padding: 0 16px; overflow-x: auto; }
    .main-tab { padding: 14px 16px; font-size: 9px; white-space: nowrap; }

    /* LEADERBOARD TOOLBAR */
    .lb-toolbar { padding: 0 16px; flex-wrap: wrap; gap: 0; }
    .mode-tabs-wrap { flex: 1 1 100%; width: 100%; border-bottom: 1px solid #1a1a1a; }
    .mode-tab { padding: 12px 14px; font-size: 12px; }
    .ladder-filters { align-items: flex-start; border-left: none; padding: 12px 0; width: 100%; min-width: 0; }
    .source-toggle { max-width: 100%; row-gap: 4px; }

    /* LEADERBOARD BODY */
    .lb-body { grid-template-columns: 1fr; padding: 20px 16px; gap: 20px; }
    .map-panel { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px; }
    .map-levelshot { height: 80px; flex: 1; min-width: 120px; }
    .map-select { width: auto; flex: 1; }
    .gh-build-wrap { flex-direction: row; align-items: center; flex: 1 1 100%; }
    .gh-note { margin: 16px 0 0; }

    /* ACTIVITY */

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { getWeapons, getLatestBuild, urlFor } from '../lib/sanity.js';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const build = await getLatestBuild();
const items = await getWeapons();
---
<BaseLayout title="Q3Rally — Rearfire Weapons">
  <div slot="topbar" class="top-bar">
    <div class="top-bar-left">
      <div class="live-dot"></div>
      <span><b>BUILD {build?.version ?? '—'}</b> &nbsp;·&nbsp; LIVE &nbsp;·&nbsp; <b>{items.length} WEAPONS</b></span>
    </div>
    <div class="top-bar-right">
      <span class="hl">FREE</span><span>·</span><span>OPEN SOURCE</span><span>·</span><span>GPL v2</span>
    </div>
  </div>

  <Nav slot="nav" active={`${b}/weapons`} build={build} />

  <div class="page-header">
    <div>
      <div class="section-label"><span>REARFIRE WEAPONS</span> &nbsp;/&nbsp; V{build?.version ?? '—'} ARSENAL</div>
      <h1 class="page-title">SHOOT /<br /><span class="orange">BACK.</span></h1>
    </div>
    <div class="page-header-right">
      <div class="count-big">{items.length}<span>.</span></div>
      <div class="count-label">Weapons</div>
    </div>
  </div>

  {items.length === 0 && (
    <section class="empty-section">
      <div class="empty-state">
        <div class="empty-icon">[ // ]</div>
        <div class="empty-label">No weapons yet.</div>
        <p class="empty-sub">Content will appear here once published in Sanity Studio.</p>
      </div>
    </section>
  )}

  <section class="items-section">
    <div class="items-grid">
      {items.map((item, i) => (
        <div class={`item-card ${i === 0 && items.length > 1 ? 'featured' : ''}`}>
          <div class="item-img">
            {item.image
              ? <img src={urlFor(item.image).width(1200).fit('max').auto('format').url()} alt={item.name} loading={i < 4 ? 'eager' : 'lazy'} />
              : <span class="placeholder">[ IMAGE ]</span>
            }
            <div class="item-img-overlay"></div>
          </div>
          <div class="item-info">
            <div class="item-name">{item.name}</div>
            {item.description && <div class="item-desc">{item.description}</div>}
          </div>
          <span class="item-num">{String(i + 1).padStart(2, '0')}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .top-bar { background: var(--black); border-bottom: 1px solid #222; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 36px; font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .top-bar-left { display: flex; align-items: center; gap: 10px; }
  .live-dot { width: 7px; height: 7px; background: var(--orange); border-radius: 50%; animation: pulse 2s infinite; }
  .top-bar-left span { color: var(--gray-light); }
  .top-bar-left span b { color: var(--white); }
  .top-bar-right { display: flex; align-items: center; gap: 16px; color: var(--gray); font-size: 10px; }
  .hl { color: var(--orange); }

  .page-header { background-color: var(--dark); background-image: var(--stripe); padding: 56px 80px 52px; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #222; }
  .section-label { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 14px; }
  .section-label span { color: var(--orange); }
  .page-title { font-family: 'Barlow Condensed', sans-serif; font-size: clamp(64px, 8vw, 110px); font-weight: 900; line-height: 0.88; text-transform: uppercase; }
  .page-title .orange { color: var(--orange); font-style: italic; }
  .page-header-right { text-align: right; }
  .count-big { font-family: 'Barlow Condensed', sans-serif; font-size: 56px; font-weight: 900; line-height: 1; }
  .count-big span { color: var(--orange); }
  .count-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 4px; }

  .items-section { padding: 48px 80px 80px; background: var(--black); }
  .items-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .item-card { background: var(--dark2); cursor: pointer; transition: background 0.15s; position: relative; overflow: hidden; }
  .item-card:hover { background: #1e1e1e; }
  .item-card:hover .item-img-overlay { opacity: 1; }
  .item-card.featured { grid-column: span 2; }
  .item-card.featured .item-img { aspect-ratio: 2/1; }
  .item-card.featured .item-name { font-size: 30px; }
  .item-img { aspect-ratio: 4/3; background-color: #161616; background-image: var(--stripe); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .item-img img { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
  .placeholder { font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #2e2e2e; }
  .item-img-overlay { position: absolute; inset: 0; background: rgba(255,85,0,0.07); opacity: 0; transition: opacity 0.2s; border: 1px solid rgba(255,85,0,0.25); }
  .item-num { position: absolute; top: 12px; right: 12px; font-family: 'Share Tech Mono', monospace; font-size: 9px; letter-spacing: 0.1em; color: #2e2e2e; }
  .item-info { padding: 18px 20px 22px; border-top: 1px solid #252525; }
  .item-name { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1; margin-bottom: 8px; }
  .item-desc { font-size: 12px; color: var(--gray); line-height: 1.55; }

  .empty-section { padding: 80px; background: var(--black); display: flex; justify-content: center; }
  .empty-state { text-align: center; }
  .empty-icon { font-family: 'Share Tech Mono', monospace; font-size: 28px; color: #2e2e2e; margin-bottom: 20px; }
  .empty-label { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray-light); margin-bottom: 10px; }
  .empty-sub { font-size: 13px; color: var(--gray); }

  @media (max-width: 768px) {
    .top-bar { padding: 0 16px; height: 32px; }
    .top-bar-right { display: none; }
    .page-header { padding: 36px 20px 32px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .items-section { padding: 28px 16px 48px; }
    .items-grid { grid-template-columns: repeat(2, 1fr); }
    .count-big { font-size: 40px; }
  }
</style>

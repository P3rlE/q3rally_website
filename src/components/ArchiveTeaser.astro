---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<aside class:list={['archive-teaser', { compact }]} aria-label="QuakeRally archive">
  <img src={`${b}/quakerally/images/qr12c.jpg`} alt="A gold car in the original QuakeRally" width="320" height="240" loading="lazy" />
  <div>
    <p class="eyebrow">From the Quake 1 era</p>
    <h2>QuakeRally Archive</h2>
    <p>Explore the original mod: historical releases, community maps, music and mapping resources. Requires Quake 1.</p>
    <a href={`${b}/quakerally/`}>Explore the archive</a>
  </div>
</aside>
<style>
  .archive-teaser { display:flex; gap:22px; align-items:center; border:1px solid #36302c; border-left:3px solid var(--orange); background:var(--dark2); padding:22px; margin-bottom:36px; }
  img { width:120px; height:100px; object-fit:cover; flex-shrink:0; }
  .eyebrow { font-family:'Share Tech Mono',monospace; font-size:12px; color:var(--orange); text-transform:uppercase; letter-spacing:.08em; }
  h2 { font-family:'Barlow Condensed',sans-serif; font-size:28px; line-height:1.15; margin:5px 0 8px; }
  p { color:var(--gray-light); font-size:16px; line-height:1.55; }
  a { display:inline-block; margin-top:12px; color:var(--orange); font-weight:700; font-size:16px; text-decoration:underline; text-underline-offset:4px; }
  a:hover { color:white; }
  a:focus-visible { outline:2px solid var(--orange); outline-offset:5px; }
  .compact { margin:0 80px 36px; }
  .compact img { width:160px; height:110px; }
  @media(max-width:768px) { .compact { margin:0 20px 28px; } .archive-teaser { align-items:start; } img,.compact img { width:80px; height:80px; } }
  @media(max-width:420px) { .archive-teaser { flex-direction:column; } img,.compact img { width:100%; height:130px; object-position:center 65%; } }
</style>

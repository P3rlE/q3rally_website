---
export interface Props {
  active?: string;
  build?: { version: string };
}
const { active = '', build } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = build?.version ?? '0.8';
const links = [
  { href: `${b}/downloads`, label: 'Downloads' },
  { href: `${b}/ladder`, label: 'Ladder' },
  { href: `${b}/news`, label: 'News' },
  { href: `${b}/media`, label: 'Media' },
  { href: `${b}/game-modes`, label: 'Game Modes' },
  { href: `${b}/cars`, label: 'Cars' },
  { href: `${b}/maps`, label: 'Maps' },
  { href: `${b}/powerups`, label: 'Powerups / Holdables' },
  { href: `${b}/weapons`, label: 'Rearfire Weapons' },
  { href: `${b}/roadside`, label: 'Roadside Objects' },
];
---
<nav>
  <a href={`${b}/`} class="nav-logo">
    <img src={`${b}/logo.png`} alt="Q3Rally" class="logo-img" />
    <span class="logo-wordmark">Q3RALLY</span>
  </a>
  <div class="version-badge">v{version} · DEV</div>
  <ul class="nav-links">
    {links.map(l => (
      <li><a href={l.href} class={active === l.href ? 'active' : ''}>{l.label}</a></li>
    ))}
  </ul>
  <div class="nav-right">
    <a href="https://github.com/Q3Rally-Team/q3rally" target="_blank" class="nav-icon" aria-label="GitHub">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="1.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
    </a>
    <a href="https://discord.gg/ascZgRCaJ" target="_blank" class="nav-icon" aria-label="Discord">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.001.022.013.043.031.057a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
    </a>
    <a href={`${b}/downloads`} class="btn-download">
      <svg viewBox="0 0 24 24" width="14" height="14" stroke="white" fill="none" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download
    </a>
  </div>
  <!-- Mobile hamburger -->
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <ul class="mobile-links">
    {links.map(l => (
      <li><a href={l.href} class={active === l.href ? 'active' : ''}>{l.label}</a></li>
    ))}
  </ul>
  <div class="mobile-menu-footer">
    <a href="https://github.com/Q3Rally-Team/q3rally" target="_blank">GitHub</a>
    <a href="https://discord.gg/ascZgRCaJ" target="_blank">Discord</a>
    <a href={`${b}/downloads`} class="mobile-dl-btn">
      <svg viewBox="0 0 24 24" width="14" height="14" stroke="white" fill="none" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('nav-hamburger');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  // Close on link click
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('open');
    btn?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }));
</script>

<style>
  nav {
    background: rgba(10,10,10,0.97);
    border-bottom: 1px solid #1e1e1e;
    display: flex; align-items: center;
    padding: 0 28px; height: 60px; gap: 32px;
    position: sticky; top: 0; z-index: 100;
    backdrop-filter: blur(8px);
  }
  .nav-logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .logo-img { width: 32px; height: 32px; object-fit: contain; }
  .logo-wordmark { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 22px; letter-spacing: 0.05em; }
  .version-badge { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: var(--gray); border: 1px solid #333; padding: 2px 8px; border-radius: 3px; flex-shrink: 0; }
  .nav-links { display: flex; align-items: center; gap: 20px; flex: 1; list-style: none; overflow: hidden; }
  .nav-links a { font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray-light); transition: color 0.15s; white-space: nowrap; }
  .nav-links a:hover, .nav-links a.active { color: var(--orange); }
  .nav-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .nav-icon { width: 32px; height: 32px; border: 1px solid #333; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: var(--gray-light); transition: border-color 0.15s; }
  .nav-icon:hover { border-color: var(--orange); color: var(--orange); }
  .btn-download { background: var(--orange); color: var(--white); font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 20px; display: flex; align-items: center; gap: 8px; transition: background 0.15s; }
  .btn-download:hover { background: var(--orange-dim); }

  /* HAMBURGER */
  .nav-hamburger { display: none; flex-direction: column; justify-content: space-between; width: 32px; height: 22px; background: none; border: none; cursor: pointer; padding: 0; margin-left: auto; flex-shrink: 0; }
  .nav-hamburger span { display: block; height: 2px; background: var(--white); transition: transform 0.2s, opacity 0.2s; }
  .nav-hamburger.open span:nth-child(1) { transform: translateY(10px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

  /* MOBILE MENU */
  .mobile-menu { display: none; position: fixed; top: 60px; left: 0; right: 0; bottom: 0; background: rgba(10,10,10,0.98); z-index: 99; flex-direction: column; padding: 32px 28px; overflow-y: auto; }
  .mobile-menu.open { display: flex; }
  .mobile-links { list-style: none; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .mobile-links a { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gray-light); display: block; padding: 10px 0; border-bottom: 1px solid #1a1a1a; transition: color 0.15s; }
  .mobile-links a:hover, .mobile-links a.active { color: var(--orange); }
  .mobile-menu-footer { display: flex; gap: 16px; align-items: center; padding-top: 24px; flex-wrap: wrap; }
  .mobile-menu-footer a { font-family: 'Share Tech Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: var(--gray); text-transform: uppercase; }
  .mobile-dl-btn { background: var(--orange); color: var(--white) !important; font-family: 'Barlow Condensed', sans-serif !important; font-weight: 800; font-size: 13px !important; letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 20px; display: flex; align-items: center; gap: 8px; margin-left: auto; }

  @media (max-width: 1600px) {
    nav { padding: 0 20px; gap: 16px; }
    .version-badge { display: none; }
    .nav-links { display: none; }
    .nav-right { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

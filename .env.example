# Sanity — aus deinem Sanity-Projekt unter sanity.io/manage
SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production
SANITY_API_TOKEN=sk...

# Webhook-Secret — selbst ausgedacht, muss in Sanity Dashboard eingetragen werden
